# Copy to .env and fill in. Never commit .env.

# Public base URL of this site, used to build OAuth redirect URIs.
# Example: PUBLIC_URL=https://photos.example.com
PUBLIC_URL=http://127.0.0.1:3000

# Port/host to listen on (defaults: 3000 / 127.0.0.1)
# PORT=3000
# HOST=127.0.0.1

# Site identity
SITE_NAME=My Site
SITE_TAGLINE=A private corner of the internet.

# Who is the owner (auto-approved, gets the admin panel).
# Format: comma-separated "provider:subject" and/or "email:address".
# Instagram subject = numeric Instagram user id; Substack subject = the "sub" claim.
# OWNER_IDS=instagram:1784xxxxxxxxx,substack:123456789
# OWNER_EMAILS=me@example.com
OWNER_IDS=
OWNER_EMAILS=

# Instagram login (Meta app with "Instagram API with Instagram Login").
# See README for setup. Visitors must use a Creator/Business Instagram account.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Substack login. Optional: if empty, the app auto-registers an OAuth client
# against Substack's live authorization server (dynamic client registration).
# Set these only if you have first-party client credentials.
SUBSTACK_CLIENT_ID=
SUBSTACK_CLIENT_SECRET=
# SUBSTACK_SCOPE=openid profile email offline_access

# Max photo upload size in MB (default 10)
# MAX_UPLOAD_MB=10

# Dev only: enables a mock provider at /login/mock?as=name (refused in production)
# MOCK_OAUTH=1
